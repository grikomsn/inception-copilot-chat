{
  "name": "inception-copilot-chat",
  "displayName": "Inception for GitHub Copilot Chat",
  "description": "Use Inception Mercury models in GitHub Copilot Chat with your Inception API key.",
  "version": "0.1.1",
  "publisher": "grikomsn",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grikomsn/inception-copilot-chat.git"
  },
  "bugs": {
    "url": "https://github.com/grikomsn/inception-copilot-chat/issues"
  },
  "homepage": "https://github.com/grikomsn/inception-copilot-chat#readme",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "inception",
    "mercury",
    "copilot",
    "copilot-chat",
    "autocomplete",
    "api-key",
    "language-model"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguageModelChatProvider:inception"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "inceptionCopilot.manage",
        "title": "Inception: Manage Connection"
      },
      {
        "command": "inceptionCopilot.configureApiKey",
        "title": "Inception: Configure API Key"
      },
      {
        "command": "inceptionCopilot.removeApiKey",
        "title": "Inception: Remove API Key"
      },
      {
        "command": "inceptionCopilot.refreshModels",
        "title": "Inception: Refresh Models"
      },
      {
        "command": "inceptionCopilot.testConnection",
        "title": "Inception: Test Inference"
      },
      {
        "command": "inceptionCopilot.openApiKeys",
        "title": "Inception: Open API Keys"
      },
      {
        "command": "inceptionCopilot.diagnostics",
        "title": "Inception: Show Diagnostics"
      },
      {
        "command": "inceptionCopilot.completionMenu",
        "title": "Inception: Completion Settings"
      },
      {
        "command": "inceptionCopilot.autocomplete.accepted",
        "title": "Inception: Log Autocomplete Acceptance"
      },
      {
        "command": "inceptionCopilot.nextEdit.accepted",
        "title": "Inception: Log Next Edit Acceptance"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "inceptionCopilot.autocomplete.accepted",
          "when": "false"
        },
        {
          "command": "inceptionCopilot.nextEdit.accepted",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Inception for Copilot Chat",
      "properties": {
        "inceptionCopilot.reasoningEffort": {
          "type": "string",
          "enum": [
            "instant",
            "low",
            "medium",
            "high"
          ],
          "default": "medium",
          "enumDescriptions": [
            "Lowest latency.",
            "Light reasoning.",
            "Balanced reasoning (default).",
            "Deeper reasoning."
          ],
          "description": "Default Mercury reasoning effort. A model-picker selection overrides this value."
        },
        "inceptionCopilot.maxOutputTokens": {
          "type": "number",
          "default": 16384,
          "minimum": 0,
          "description": "Maximum output tokens requested from Inception hosted models. Use 0 to use the selected model's advertised maximum."
        },
        "inceptionCopilot.requestTimeoutSeconds": {
          "type": "number",
          "default": 600,
          "minimum": 10,
          "description": "Maximum duration of a Inception inference request in seconds."
        },
        "inceptionCopilot.streamIdleTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 10,
          "description": "Maximum time without receiving streamed Inception response data before aborting a request."
        },
        "inceptionCopilot.catalogCacheMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "How long the Inception hosted-model catalog is reused before refreshing."
        },
        "inceptionCopilot.debugLogging": {
          "type": "boolean",
          "default": false,
          "description": "Log request, stream, usage, and model-discovery metadata to the Inception output channel. Prompts and API keys are never logged."
        },
        "inceptionCopilot.sendFeedback": {
          "type": "boolean",
          "default": true,
          "description": "Report suggestion acceptance outcomes to Inception to improve model quality. Only outcome metadata is sent; never code, prompts, or API keys."
        },
        "inceptionCopilot.autocomplete": {
          "type": "object",
          "default": {
            "enabled": true,
            "model": "mercury-edit-2",
            "debounceMs": 100,
            "maxTokens": 256,
            "maxPromptTokens": 8192,
            "requestTimeoutMs": 5000
          },
          "description": "Inline autocomplete powered by the Inception fill-in-the-middle endpoint.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Provide inline autocomplete suggestions using Mercury Edit."
            },
            "model": {
              "type": "string",
              "default": "mercury-edit-2",
              "description": "Inception FIM model used for inline autocomplete."
            },
            "debounceMs": {
              "type": "number",
              "default": 100,
              "minimum": 0,
              "maximum": 2000,
              "description": "Delay after typing stops before requesting a suggestion. Explicit invocations skip this delay."
            },
            "maxTokens": {
              "type": "number",
              "default": 256,
              "minimum": 16,
              "maximum": 8192,
              "description": "Maximum tokens generated per autocomplete suggestion."
            },
            "maxPromptTokens": {
              "type": "number",
              "default": 8192,
              "minimum": 256,
              "maximum": 32000,
              "description": "Prompt context budget (prefix plus suffix) in estimated tokens. The prefix keeps three quarters of the budget."
            },
            "requestTimeoutMs": {
              "type": "number",
              "default": 5000,
              "minimum": 500,
              "maximum": 60000,
              "description": "Maximum duration of an autocomplete request in milliseconds."
            }
          }
        },
        "inceptionCopilot.nextEdit": {
          "type": "object",
          "default": {
            "enabled": true,
            "model": "mercury-edit-2",
            "debounceMs": 150,
            "maxTokens": 1024,
            "editableLines": 15,
            "maxPromptTokens": 16384,
            "snippetContextLines": 10,
            "historyDepth": 5,
            "requestTimeoutMs": 8000
          },
          "description": "Next-edit suggestions powered by the Inception edit endpoint.",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Provide next-edit suggestions using Mercury Edit. Off by default; enable from the status bar menu."
            },
            "model": {
              "type": "string",
              "default": "mercury-edit-2",
              "description": "Inception edit model used for next-edit suggestions."
            },
            "debounceMs": {
              "type": "number",
              "default": 150,
              "minimum": 0,
              "maximum": 2000,
              "description": "Delay after typing stops before requesting a suggestion. Explicit invocations skip this delay."
            },
            "maxTokens": {
              "type": "number",
              "default": 1024,
              "minimum": 64,
              "maximum": 8192,
              "description": "Maximum tokens generated for the updated editable region."
            },
            "editableLines": {
              "type": "number",
              "default": 15,
              "minimum": 5,
              "maximum": 25,
              "description": "Size of the editable region around the cursor in lines. Larger regions increase latency."
            },
            "maxPromptTokens": {
              "type": "number",
              "default": 16384,
              "minimum": 1024,
              "maximum": 32000,
              "description": "Estimated token budget for the current-file context. Distant regions are trimmed when the file exceeds it."
            },
            "snippetContextLines": {
              "type": "number",
              "default": 10,
              "minimum": 0,
              "maximum": 50,
              "description": "Lines of context captured around recent cursor positions in other files."
            },
            "historyDepth": {
              "type": "number",
              "default": 5,
              "minimum": 0,
              "maximum": 10,
              "description": "Number of recent edits sent as diff history. 0 disables edit history."
            },
            "requestTimeoutMs": {
              "type": "number",
              "default": 8000,
              "minimum": 1000,
              "maximum": 60000,
              "description": "Maximum duration of a next-edit request in milliseconds."
            }
          }
        }
      }
    },
    "languageModelChatProviders": [
      {
        "vendor": "inception",
        "displayName": "Inception",
        "configuration": {
          "type": "object",
          "required": [
            "apiKey"
          ],
          "properties": {
            "apiKey": {
              "type": "string",
              "title": "Inception API Key",
              "description": "API key for this Inception provider entry. VS Code stores configured secrets securely.",
              "secret": true
            }
          }
        }
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "check": "npm test",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run check && vsce publish --skip-duplicate",
    "prepackage": "npm run check",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3"
  }
}
